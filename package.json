{
  "name": "worklife-calendar",
  "version": "2.14.29",
  "description": "Calendar, task tracker, habit tracker, and financial planner for Obsidian",
  "author": "AtinsS",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "svelte-check && eslint . --ext .ts",
    "build": "npm run lint && rollup -c rollup.config.mjs",
    "test": "jest --passWithNoTests",
    "test:watch": "yarn test -- --watch"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "d3": "^7.9.0",
    "luxon": "^3.7.2",
    "obsidian": "obsidianmd/obsidian-api#master",
    "obsidian-calendar-ui": "0.3.12",
    "obsidian-daily-notes-interface": "0.9.0",
    "svelte": "^3.59.2",
    "tslib": "2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "18.0.0",
    "@rollup/plugin-node-resolve": "11.2.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@tsconfig/svelte": "1.0.10",
    "@types/jest": "26.0.22",
    "@types/moment": "2.13.0",
    "@typescript-eslint/eslint-plugin": "4.20.0",
    "@typescript-eslint/parser": "4.20.0",
    "eslint": "7.23.0",
    "jest": "26.6.3",
    "moment": "2.29.1",
    "rollup": "2.44.0",
    "rollup-plugin-svelte": "7.1.0",
    "svelte-check": "^2.9.2",
    "svelte-jester": "1.3.2",
    "svelte-preprocess": "^5.1.4",
    "ts-jest": "26.5.4",
    "typescript": "^4.9.5"
  },
  "jest": {
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.svelte$": [
        "svelte-jester",
        {
          "preprocess": true
        }
      ],
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "svelte"
    ]
  }
}
